[Unit]
Description=Friendly host x11vnc (localhost only — Phase 3)
After=xvfb.service
Requires=xvfb.service

[Service]
Type=simple
User=assistant
EnvironmentFile=-/etc/friendly-host.env
Environment=DISPLAY=:99
ExecStart=/usr/bin/x11vnc -display :99 -localhost -rfbport 5900 -forever -shared -nopw -xkb
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
