[Unit]
Description=Friendly host Control API (FastAPI)
After=network.target xvfb.service
Wants=xvfb.service

[Service]
Type=simple
User=assistant
WorkingDirectory=/opt/friendly-host/agent
EnvironmentFile=-/etc/friendly-host.env
Environment=DISPLAY=:99
ExecStart=/opt/friendly-host/agent/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8787
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
