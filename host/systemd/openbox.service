[Unit]
Description=Friendly host Openbox on Xvfb
After=xvfb.service
Requires=xvfb.service

[Service]
Type=simple
User=assistant
EnvironmentFile=-/etc/friendly-host.env
Environment=DISPLAY=:99
# setup-ubuntu-headless.sh rewrites this path to the installed host tree.
ExecStart=/usr/bin/openbox --config-file /home/assistant/.config/openbox/rc.xml
Restart=on-failure
RestartSec=2

[Install]
WantedBy=multi-user.target
