# Friendly Host Control API — copy to .env and fill in secrets
# Never commit .env

# The host refuses to start while API_TOKEN is empty or this placeholder (e.g. openssl rand -hex 32).
API_TOKEN=change-me-to-a-long-random-secret

DISPLAY=:99
SCREEN_WIDTH=1280
SCREEN_HEIGHT=720
SCREEN_DEPTH=24

API_HOST=127.0.0.1
API_PORT=8787

CHROMIUM_BIN=chromium
CHROMIUM_PROFILE_DIR=/var/lib/assistant/chromium-profile
BROWSER_START_URL=about:blank

# Stream / noVNC (Phase 3)
# Ports 5999/6099 avoid clashing with common :1 lab stacks on 5900/6080
STREAM_TTL_SECONDS=900
# Optional dedicated JWT secret; defaults to derived from API_TOKEN
STREAM_JWT_SECRET=
VNC_BIND=127.0.0.1
VNC_PORT=5999
NOVNC_PORT=6099
NOVNC_WEB_ROOT=/usr/share/novnc
# localhost | auto | tailscale | cloudflare | cloudflare_quick
TUNNEL_MODE=auto
# Tailscale-only HTTPS listener for noVNC; keep separate from Funnel on :443.
TAILSCALE_SERVE_PORT=8443
CLOUDFLARED_TOKEN=
CLOUDFLARED_CONFIG=

# MCP Streamable HTTP
# MCP_ALLOWED_HOSTS=100.64.0.12,100.64.0.12:*,desktop.tailnet.ts.net,desktop.tailnet.ts.net:*
MCP_ALLOWED_HOSTS=
