<?xml version="1.0" encoding="utf-8"?>
<!-- Play Store distribution: cleartext off; phone automation / call / overlay not merged. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:tools="http://schemas.android.com/tools">

  <!-- Remove permissions which could be merged from Nightly-only dependencies.
       Only phone automation (overlay pill, cellular calls) and screen time use them;
       both are blocked on Play. Desktop control, JS, workspace and MCP need none of them.
       tools:ignore: lint flags these removal lines as if they requested the permission. -->
  <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" tools:node="remove"
    tools:ignore="ProtectedPermissions,PermissionImpliesUnsupportedChromeOsHardware" />
  <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS" tools:node="remove"
    tools:ignore="ProtectedPermissions,PermissionImpliesUnsupportedChromeOsHardware" />
  <uses-permission android:name="android.permission.CALL_PHONE" tools:node="remove"
    tools:ignore="ProtectedPermissions,PermissionImpliesUnsupportedChromeOsHardware" />
  <uses-permission android:name="android.permission.ANSWER_PHONE_CALLS" tools:node="remove"
    tools:ignore="ProtectedPermissions,PermissionImpliesUnsupportedChromeOsHardware" />
  <uses-permission android:name="android.permission.READ_PHONE_STATE" tools:node="remove"
    tools:ignore="ProtectedPermissions,PermissionImpliesUnsupportedChromeOsHardware" />

  <application
    android:usesCleartextTraffic="false"
    tools:replace="android:usesCleartextTraffic" />

</manifest>
