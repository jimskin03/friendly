<?xml version="1.0" encoding="utf-8"?>
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:shortcutId="new_prompt"
        android:enabled="true"
        android:icon="@drawable/ic_shortcut_new_prompt"
        android:shortcutShortLabel="@string/shortcut_new_prompt"
        android:shortcutLongLabel="@string/shortcut_new_prompt">
        <intent
            android:action="app.friendly.assistant.action.NEW_PROMPT"
            android:targetClass="app.friendly.assistant.RouteActivity" />
        <categories android:name="android.shortcut.conversation" />
    </shortcut>
    <shortcut
        android:shortcutId="new_voice"
        android:enabled="true"
        android:icon="@drawable/ic_shortcut_new_voice"
        android:shortcutShortLabel="@string/shortcut_new_voice"
        android:shortcutLongLabel="@string/shortcut_new_voice">
        <intent
            android:action="app.friendly.assistant.action.NEW_VOICE"
            android:targetClass="app.friendly.assistant.RouteActivity" />
        <categories android:name="android.shortcut.conversation" />
    </shortcut>
</shortcuts>
