<?xml version="1.0" encoding="utf-8"?>
<!--
  Nightly (sideload): same certificate rules as Play, but plain http:// is allowed so LAN /
  Tailscale servers without TLS keep working.
-->
<network-security-config>
  <base-config cleartextTrafficPermitted="true">
    <trust-anchors>
      <certificates src="system" />
      <certificates src="user" />
    </trust-anchors>
  </base-config>
</network-security-config>
